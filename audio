const music = new Audio("audio/ambiance.mp3");
music.loop = true;
music.volume = 0.4;

const qteSound = new Audio("audio/qte.mp3");
qteSound.volume = 0.8;

function startMusic() {
  if (music.paused) {
    music.play().catch(()=>{});
  }
}
